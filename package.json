    "eval": "node -e \"console.log(\\\"eval: not implemented (stage 8)\\\")\"",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@huggingface/transformers": "4.3.1",
    "mammoth": "1.13.0",
    "next": "16.4.3",
    "pino": "10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typebox": "1.3.27",
    "unpdf": "1.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
