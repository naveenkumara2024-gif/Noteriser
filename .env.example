# Copy to .env.local. Placeholders only; never commit real keys.

# fake = scripted LLM/NLI, no keys needed (tests, e2e, demo). live = real providers.
LLM_MODE=fake

# ======================================================================
#  THE SWITCH. Change this ONE line to change provider:
#      LLM_PROFILE=nararouter      (a custom OpenAI-compatible router)
#      LLM_PROFILE=openrouter      (OpenRouter)
#  For a single command you can also use:  npx tsx scripts/llm-smoke.ts --profile openrouter
# ======================================================================
LLM_PROFILE=nararouter

# Optional: run the generator and the judge on DIFFERENT providers (best for independent checking).
# Uncomment both lines; they override LLM_PROFILE for that role.
# GEN_PROFILE=nararouter
# JUDGE_PROFILE=openrouter

# ----------------------------------------------------------------------
#  A profile is a group of variables that share a prefix: <NAME>_BASE_URL, <NAME>_GEN_MODEL,
#  <NAME>_JUDGE_MODEL, <NAME>_API_KEY. The profile name is the provider id.
#   - A name pi-ai knows (openrouter, anthropic, openai, google, groq, ...) uses its catalog; the
#     base URL is optional and the model ids must exist in the installed pi-ai catalog.
#   - Any other name (nararouter, my-proxy, ...) is a custom OpenAI-compatible endpoint: set its
#     BASE_URL and use model ids exactly as that service names them. Hyphens become underscores in
#     the prefix (my-proxy -> MY_PROXY_*). The model must support tool/function calling.
#  Add as many profiles as you like; only the selected one(s) are used.
# ----------------------------------------------------------------------

# Profile: nararouter
NARAROUTER_BASE_URL=https://router.bynara.id/v1
NARAROUTER_GEN_MODEL=agnes-2.5-flash
NARAROUTER_JUDGE_MODEL=nemotron-3.5-lightning-free
# NARAROUTER_API_KEY=

# Profile: openrouter. Two cheap, non-reasoning models from different vendors (about $0.01 per
# lecture-sized run at catalog prices): Claude Haiku writes, GPT-4o-mini checks.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_GEN_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_JUDGE_MODEL=openai/gpt-4o-mini
# OPENROUTER_API_KEY=

# Stored runs (audit log) older than this are purged. 1..720.
RUN_TTL_HOURS=24

# Web server limits (all optional). Runs allowed per client address per window; the in-memory limiter
# resets on restart and trusts X-Forwarded-For, so it is a courtesy guard, not a security boundary.
# RATE_LIMIT_RUNS=6
# RATE_LIMIT_WINDOW_MINUTES=10
# Per-run caps (a run that passes one stops and says which). Defaults shown.
# MAX_SENTENCES=600
# MAX_LLM_CALLS=800
# MAX_COST_USD=2
# RUN_TIMEOUT_MINUTES=30
# Where live runs are stored (default data/noteriser.db). Fake mode keeps runs in memory.
# NOTERISER_DB=data/noteriser.db
# Fake mode only: wait this many ms inside each scripted model call, so progress and cancel are visible.
# FAKE_DELAY_MS=0

# ----------------------------------------------------------------------
#  Advanced (optional): settings without profiles. A generic variable that is set always wins over
#  the profile's value, so you can override one thing for one run.
#    LLM_PROVIDER / GEN_PROVIDER / JUDGE_PROVIDER   provider for both roles / one role
#    GEN_MODEL / JUDGE_MODEL                        bare model id, or provider:model with no provider set
#    LLM_BASE_URL / GEN_BASE_URL / JUDGE_BASE_URL   endpoint (LLM_BASE_URL only reaches roles with no
#                                                   provider of their own)
#    LLM_API_KEY                                    shared key for any custom provider
#  Built-in provider keys (read by pi-ai): ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY (google),
#  OPENROUTER_API_KEY, GROQ_API_KEY, MISTRAL_API_KEY, XAI_API_KEY, DEEPSEEK_API_KEY.
# ----------------------------------------------------------------------
