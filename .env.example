# Copy to .env.local. Placeholders only; never commit real keys.

# fake = scripted LLM/NLI, no keys needed (tests, e2e, demo). live = real providers.
LLM_MODE=fake

# Format provider:model. Prefer a different provider for the judge (CLAUDE.md invariant 2).
# Required when LLM_MODE=live. Model ids must exist in the installed @earendil-works/pi-ai catalog.
GEN_MODEL=
JUDGE_MODEL=

# Stored runs (audit log) older than this are purged. 1..720.
RUN_TTL_HOURS=24

# Provider keys are read by pi-ai from the environment. Set only what you use:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
